# Synthetic repeated-outcome example, not a general one-to-one rule.
# Based on Cochrane Section 5.2.1 / MECIR C42.
direction: down
reports: "Three reports\nSame participants\nSame outcome" {shape: document}
linked: "One linked study\nKeep complementary details"
count: "One study contribution\nNot three trials"
reports -> linked: trace original investigation
linked -> count: count the study once
